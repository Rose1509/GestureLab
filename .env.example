# Session (required for login and Google OAuth state)
# Use a long random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET_KEY=your-secret-key-change-in-production

# App name (used in emails)
APP_NAME=GestureLab

# Password reset (Forgot Password)
# Optional but recommended: set a separate secret used to hash reset codes.
# If unset, the app falls back to SESSION_SECRET_KEY.
RESET_CODE_SECRET=your-reset-code-secret-change-in-production

# Dev-only: if set to 1, the reset code will be shown on-screen
# instead of requiring SMTP to be configured.
DEV_SHOW_RESET_CODE=0

# SMTP email settings (required for Forgot Password emails, unless DEV_SHOW_RESET_CODE=1)
# Example (Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraccount@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM="GestureLab <youraccount@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
# Create an "OAuth 2.0 Client ID" (Web application). Add to "Authorized redirect URIs":
#   http://127.0.0.1:8000/auth/google/callback
#   (and http://localhost:8000/auth/google/callback if you use localhost)
# Add to "Authorized JavaScript origins": http://127.0.0.1:8000 and http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Optional: Sign language model paths (defaults: project root)
# SIGN_MODEL_PATH=path/to/sign_language_model_improved.keras
# SIGN_LABELS_PATH=path/to/class_labels.pkl
