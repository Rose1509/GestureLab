# Google OAuth Configuration
# Choose ONE of the following two options:

# Option 1: Using Google Cloud Console secrets file (RECOMMENDED)
# Download your OAuth 2.0 credentials JSON file from Google Cloud Console
# and place it in your project directory, then set the path below:
GOOGLE_CLIENT_SECRETS_FILE=./credentials.json

# Option 2: Using individual credentials (if you don't have the secrets file)
# Get these values from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
